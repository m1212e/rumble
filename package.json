{
  "name": "@m1212e/rumble",
  "module": "./out/index.mjs",
  "version": "0.25.0",
  "type": "module",
  "repository": "https://github.com/m1212e/rumble",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "format": "bun run lint",
    "lint": "bunx biome check --write .",
    "dev:docker": "docker compose -f ./dev.docker-compose.yml up",
    "dev:example": "bun ./example/src/main.ts",
    "dev:example:seed": "bun example/src/db/seed.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --noEmit",
    "fallow": "fallow audit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@graphql-tools/executor-http": "^3.4.1",
    "@m1212e/sofa-api": "^0.18.12",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/pluralize": "^0.0.33",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "drizzle-seed": "^1.0.0-rc.5-ab785fc",
    "expect-type": "^1.4.0",
    "fallow": "^3.31.0",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.3.0",
    "lefthook": "^2.1.16",
    "pg": "^8.23.1",
    "rolldown-plugin-dts": "^0.28",
    "svelte": "^5.57.1",
    "tsdown": "^0.23",
    "typescript": "^7.0"
  },
  "peerDependencies": {
    "typescript": "^4 || ^5 || ^6 || ^7",
    "drizzle-orm": "^1",
    "graphql": "^16 || ^17",
    "@m1212e/sofa-api": "^0.18",
    "graphql-ws": "^6",
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "graphql-ws": {
      "optional": true
    },
    "@m1212e/sofa-api": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "^3.2.0",
    "@graphql-yoga/plugin-disable-introspection": "^2.25.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-drizzle": "^0.20.0",
    "@pothos/plugin-smart-subscriptions": "^4.1.7",
    "@pothos/plugin-tracing": "^1.1.4",
    "@pothos/plugin-validation": "^4.3.4",
    "@pothos/tracing-opentelemetry": "^1.2.1",
    "@urql/core": "^6.0.3",
    "@urql/exchange-graphcache": "^9.0.1",
    "@urql/introspection": "^1.2.1",
    "dataloader": "^2.2.3",
    "devalue": "^6.0.2",
    "es-toolkit": "^1.52.0",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.24.1",
    "lib-address": "^0.7.0",
    "libphonenumber-js": "^1.13.14",
    "pluralize": "^8.0.0",
    "wonka": "^6.3.6",
    "zod": "^4.6.5"
  },
  "main": "./out/index.cjs",
  "types": "./out/index.d.cts",
  "exports": {
    ".": {
      "import": "./out/index.mjs",
      "require": "./out/index.cjs"
    },
    "./client": {
      "import": "./out/client.mjs",
      "require": "./out/client.cjs"
    },
    "./client/generate": {
      "import": "./out/client/generate.mjs",
      "require": "./out/client/generate.cjs"
    },
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@whatwg-node/promise-helpers": "1.3.2",
    "@whatwg-node/server": "0.11.0",
    "fets": "0.8.10",
    "hotscript": "1.0.13",
    "json-schema-to-ts": "3.1.1",
    "ts-algebra": "2.0.0"
  }
}
